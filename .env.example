# Copy this file to .env and adjust values as needed.
JWT_SECRET=supersecretkey # auto-generated and persisted in /data if not set
PG_HOST=localhost # leave empty to use embedded Postgres
PG_USER=anchor
PG_PASSWORD=password
PG_DATABASE=anchor
PG_PORT=5432

# Optional: Set to 'disabled', 'enabled', or 'review' to lock sign up mode.
# If not set, admins can control it via the admin panel.
# USER_SIGNUP=enabled

# Login brute-force protection (defaults shown)
# LOGIN_MAX_ATTEMPTS=5          # Failed attempts before lockout
# LOGIN_LOCKOUT_MINUTES=15      # How long the lockout lasts
# LOGIN_ATTEMPT_WINDOW_MINUTES=15 # Window for counting failed attempts